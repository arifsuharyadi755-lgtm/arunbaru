rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'arifsuharyadi755@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // 3. Validation Helpers
    function isValidArticle(data) {
      return data.keys().hasAll(['id', 'title', 'slug', 'category', 'categoryName', 'summary', 'author', 'timestamp']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 250 &&
        data.slug is string && data.slug.size() <= 150 &&
        data.category is string && (data.category in ['politik', 'olahraga', 'kriminal', 'ekonomi', 'daerah', 'lain_lain', 'lapor_warga', 'legalitas']) &&
        data.categoryName is string && data.categoryName.size() <= 50 &&
        data.summary is string && data.summary.size() <= 600 &&
        data.author is string && data.author.size() <= 100 &&
        data.timestamp is number;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['id', 'articleId', 'author', 'text']) &&
        data.id is string && data.id.size() <= 128 &&
        data.articleId is string && data.articleId.size() <= 128 &&
        data.author is string && data.author.size() <= 100 &&
        data.text is string && data.text.size() <= 1000;
    }

    function isValidDonation(data) {
      return data.keys().hasAll(['id', 'name', 'amount', 'cups']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 100 &&
        data.amount is number && data.amount > 0 &&
        data.cups is number && data.cups > 0;
    }

    function isValidAd(data) {
      return data.keys().hasAll(['id', 'brandName', 'contactName', 'email', 'phoneWhatsapp', 'headline', 'packageType', 'totalCost']) &&
        data.id is string && data.id.size() <= 128 &&
        data.brandName is string && data.brandName.size() <= 100 &&
        data.contactName is string && data.contactName.size() <= 100 &&
        data.email is string && data.email.size() <= 100 &&
        data.phoneWhatsapp is string && data.phoneWhatsapp.size() <= 50 &&
        data.headline is string && data.headline.size() <= 200 &&
        data.packageType is string && (data.packageType in ['leaderboard_top', 'sidebar_rectangle', 'native_advertorial', 'push_notification']) &&
        data.totalCost is number && data.totalCost >= 0;
    }

    // 4. Collection Match Blocks

    // News Articles & Citizen Submissions
    match /articles/{articleId} {
      allow read: if true;
      allow create: if isValidId(articleId) && isValidArticle(incoming());
      allow update: if isValidId(articleId) && (
        isAdmin() ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount']) && incoming().viewsCount is number && incoming().viewsCount >= existing().viewsCount) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['commentCount']) && incoming().commentCount is number)
      );
      allow delete: if isValidId(articleId) && isAdmin();
    }

    // Reader Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isValidId(commentId) && isValidComment(incoming());
      allow update: if isValidId(commentId) && (
        isAdmin() ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['upvotes', 'downvotes']) && incoming().upvotes is number && incoming().downvotes is number)
      );
      allow delete: if isValidId(commentId) && isAdmin();
    }

    // Reader Coffee Tips & Donations
    match /donations/{donationId} {
      allow read: if true;
      allow create: if isValidId(donationId) && isValidDonation(incoming());
      allow update, delete: if isValidId(donationId) && isAdmin();
    }

    // Advertising Inquiries & Orders
    match /ads/{adId} {
      allow read: if true;
      allow create: if isValidId(adId) && isValidAd(incoming());
      allow update, delete: if isValidId(adId) && isAdmin();
    }

    // Brand Visual Identity & Editorial Structure Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId) && isAdmin();
    }

    // Connection Health Check Document
    match /test/connection {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
